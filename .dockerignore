# Keep the build context small and secret-free.
.git
.gitignore
.venv
venv
env
ENV
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage

# Never bake secrets or local data into the image.
.env
*.env
!.env.example
data/
*.sqlite
*.sqlite3
*.db
*.db-*
logs/
*.log

# Docs/dev-only files not needed at runtime.
tests/
requirements-dev.txt
