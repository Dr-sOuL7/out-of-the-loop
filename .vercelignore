# Root-anchored (leading /) so nothing inside src/ is ever matched.
# NOTE: src/ootl/content/data/*.json MUST ship with the deployment.
# pyproject.toml is excluded so Vercel installs from requirements.txt only
# (one canonical dependency source for the serverless build).
/pyproject.toml
/.venv
/venv
/tests
/data
/.pytest_cache
/.github
/Dockerfile
/docker-compose.yml
/Procfile
/render.yaml
__pycache__
*.pyc
*.db
