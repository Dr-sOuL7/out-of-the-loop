# =============================================================================
# Out of the Loop -- environment configuration
# Copy this file to ".env" and fill in the values. NEVER commit your real .env.
# =============================================================================

# REQUIRED: Telegram bot token from @BotFather.
# In Telegram, message @BotFather -> /newbot -> follow the prompts.
# BotFather replies with a token that looks like:  123456789:ABCdef...
BOT_TOKEN=

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=data/ootl.db

# --- Game timing (seconds) ---------------------------------------------------
ANSWER_TIME_SECONDS=150
VOTE_TIME_SECONDS=60
GUESS_TIME_SECONDS=45

# --- Lobby rules -------------------------------------------------------------
MIN_PLAYERS=3
MAX_PLAYERS=9
DEFAULT_ROUNDS=5

# --- Content selection -------------------------------------------------------
# How many recently-used words/questions to avoid before allowing a repeat.
WORD_HISTORY_WINDOW=40
QUESTION_HISTORY_WINDOW=20

# --- Logging -----------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
